---
import { getCollection } from 'astro:content'
import type { GetStaticPathsOptions } from 'astro'
import Main from '@/layouts/Main.astro'
import Layout from '@/layouts/Layout.astro'
import Header from '@/components/Header.astro'
import Footer from '@/components/Footer.astro'
import Card from '@/components/Card.astro'
import Pagination from '@/components/Pagination.astro'
import { getUniqueTags } from '@/utils/getUniqueTags'
import { getSortedPosts } from '@/utils/getSortedPosts'
import { slugifyAll } from '@/utils/slugify'
import config from '@/config'

export async function getStaticPaths({ paginate }: GetStaticPathsOptions) {
  const posts = await getCollection('blog')
  const tags = getUniqueTags(posts)

  return tags.flatMap(({ tag, tagName }) => {
    const tagPosts = getSortedPosts(posts.filter(({ data }) => slugifyAll(data.tags).includes(tag)))

    return paginate(tagPosts, {
      params: { tag },
      props: { tagName },
      pageSize: config.posts.perPage
    })
  })
}

const { page, tagName } = Astro.props
---

<Layout title={`Tag: ${tagName} | ${config.site.title}`}>
  <Header />
  <Main pageTitle={[`Tag:`, `${tagName}`]} pageDesc={`All the notes with the tag "${tagName}".`}>
    <h1 slot="title" transition:name={tagName}>{`Tag:${tagName}`}</h1>
    <ul>
      {page.data.map((data) => <Card {...data} />)}
    </ul>
  </Main>

  <Pagination {page} />

  <Footer noMarginTop={page.lastPage > 1} />
</Layout>
